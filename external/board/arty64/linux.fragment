CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
# CVA6 traps unaligned accesses; Codethink found emulation problematic on CVA6.
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# rv32 defconfig enables VGA console, which needs screen_info (x86-only)
# CONFIG_VGA_CONSOLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_PCI is not set
# CONFIG_EFI is not set

# --- shrink: only what is needed to boot from initramfs on this SoC ---
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LOWRISC=y
CONFIG_LOWRISC_DIGILENT_100MHZ=m
CONFIG_PHYLIB=y
CONFIG_MDIO_BITBANG=y
CONFIG_DP83848_PHY=y
# keep the module set tiny
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_BLOCK is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_NFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_AUDIT is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KVM is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SMP is not set
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_COMPRESSION_XZ=y
