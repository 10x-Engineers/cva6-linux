# CVA6 32-bit Linux on the Digilent Arty A7-100T (cv32a6_imac_sv32)

# Architecture: RV32IMA + C, soft-float ilp32 (no F/D in the bitstream)
BR2_riscv=y
BR2_RISCV_32=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVI=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ABI_ILP32=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_AS_KERNEL=y

# System
BR2_TARGET_GENERIC_HOSTNAME="arty32"
BR2_TARGET_GENERIC_ISSUE="CVA6 Arty A7-100T (rv32imac)"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_57600=y

# Root filesystem: built into the kernel Image
BR2_TARGET_ROOTFS_INITRAMFS=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_DEFCONFIG="rv32"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ARTY_PATH)/board/arty32/linux.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_ARTY_PATH)/patches/linux"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ARTY_PATH)/board/arty32/post-build.sh"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_ARTY_PATH)/board/arty32/arty32.dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="arty32"

# Network diagnostics (ethtool -d eth0 dumps PHY + MAC registers)
BR2_PACKAGE_ETHTOOL=y

# busybox ntpd (clock from the network)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ARTY_PATH)/board/busybox.fragment"

# Shared rootfs overlay: S41ethernet
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ARTY_PATH)/board/common/rootfs-overlay"
